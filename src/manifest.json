{
  "manifest_version": 3,
  "name": "Recipe Mode: hands-free cooking",
  "short_name": "Recipe Mode",
  "version": "1.3.0",
  "description": "A voice recipe reader with kitchen timers. Open a recipe, say \"next\" or \"how much butter?\" and it answers out loud.",
  "homepage_url": "https://github.com/dgr8akki/recipe-mode",
  "minimum_chrome_version": "116",
  "permissions": ["alarms", "notifications", "sidePanel", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "action": {
    "default_title": "Open Recipe Mode",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
